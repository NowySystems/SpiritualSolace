# ChurchWork Supabase project
# Copy this file to .env.local for local development.
# Vercel should store these as project environment variables.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server/admin only. Never expose this in browser code.
# Add only when server-side admin operations are implemented.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile public site key. Matching secret lives in Supabase Auth Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
