{
  "id": "/admin",
  "name": "ChurchWork",
  "short_name": "ChurchWork",
  "description": "Spiritual-care operations for requesters, facilities, and partner care teams.",
  "start_url": "/admin?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "orientation": "any",
  "background_color": "#edf4f0",
  "theme_color": "#082838",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    {
      "src": "/brand/churchwork-corner-logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/churchwork-corner-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Admin Portal",
      "short_name": "Admin",
      "description": "Open the ChurchWork admin access hub.",
      "url": "/admin?source=pwa-shortcut",
      "icons": [{ "src": "/brand/churchwork-corner-logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Requester Portal",
      "short_name": "Requester",
      "description": "Open the requester portal.",
      "url": "/requester-portal?source=pwa-shortcut",
      "icons": [{ "src": "/brand/churchwork-corner-logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Facility Portal",
      "short_name": "Facility",
      "description": "Open the facility workspace.",
      "url": "/facility-portal?source=pwa-shortcut",
      "icons": [{ "src": "/brand/churchwork-corner-logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Partner Portal",
      "short_name": "Partner",
      "description": "Open the partner workspace.",
      "url": "/partner-portal?source=pwa-shortcut",
      "icons": [{ "src": "/brand/churchwork-corner-logo.png", "sizes": "192x192" }]
    }
  ]
}
