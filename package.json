{
  "name": "crcf-funding-command",
  "version": "2.2.0",
  "private": true,
  "description": "Internal grant, funding, proposal-matching, source-monitoring, opportunity, and donor-market intelligence dashboard for Cookeville Regional Charitable Foundation.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "foundation:check": "node agents/scripts/foundation-check.mjs",
    "check:public-quality": "node agents/scripts/public-quality-check.mjs",
    "check:ux-alignment": "node agents/scripts/ux-render-alignment-check.mjs",
    "check:state": "node agents/scripts/state-reconciliation-check.mjs",
    "check:routes": "node agents/scripts/route-smoke-check.mjs",
    "check:guardrails": "node agents/scripts/guardrail-review-check.mjs",
    "check:staff": "node agents/scripts/run-staff-checks.mjs",
    "validate": "npm run foundation:check && npm run typecheck && npm run build",
    "test:smoke": "playwright test",
    "check:pr-acceptance": "node agents/scripts/pr-acceptance-check.mjs",
    "check:ci-source": "node agents/scripts/ci-source-of-truth-check.mjs",
    "check:visual-screenshots": "node agents/scripts/visual-screenshot-helper.mjs",
    "check:competitive-intel": "node agents/scripts/competitive-intelligence-skeleton.mjs",
    "check:opportunity-scout": "node agents/scripts/opportunity-scout-skeleton.mjs",
    "check:advisor": "node agents/scripts/project-advisor-skeleton.mjs"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "foundation",
    "grants",
    "funding",
    "nonprofit",
    "internal-dashboard"
  ],
  "license": "UNLICENSED"
}
