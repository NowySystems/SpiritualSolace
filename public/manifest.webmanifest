{
  "name": "ChurchWork",
  "short_name": "ChurchWork",
  "description": "Spiritual-care operations for requesters, facilities, and partner care teams.",
  "start_url": "/pilot",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#edf4f0",
  "theme_color": "#082838",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    {
      "src": "/brand/churchwork-corner-logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/churchwork-corner-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Pilot Launchpad",
      "short_name": "Pilot",
      "description": "Open the internal ChurchWork pilot launchpad.",
      "url": "/pilot",
      "icons": [{ "src": "/brand/churchwork-corner-logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Requester Portal",
      "short_name": "Requester",
      "description": "Open the requester portal.",
      "url": "/requester-portal",
      "icons": [{ "src": "/brand/churchwork-corner-logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Facility Portal",
      "short_name": "Facility",
      "description": "Open the facility workspace.",
      "url": "/facility-portal",
      "icons": [{ "src": "/brand/churchwork-corner-logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Partner Portal",
      "short_name": "Partner",
      "description": "Open the partner workspace.",
      "url": "/partner-portal",
      "icons": [{ "src": "/brand/churchwork-corner-logo.png", "sizes": "192x192" }]
    }
  ]
}
