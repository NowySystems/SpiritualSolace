# ChurchWork Supabase project
# Copy this file to .env.local for local development.
# Vercel should store these as project environment variables.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for internal-only admin/demo/diagnostic routes.
# Use a long random secret and store it only in local/Vercel environment configuration.
CHURCHWORK_INTERNAL_ACCESS_KEY=

# Server/admin only. Never expose this in browser code.
# Add only when server-side admin operations are implemented.
SUPABASE_SERVICE_ROLE_KEY=


# ChurchWork transactional email (Resend)
RESEND_API_KEY=
CHURCHWORK_FROM_EMAIL=ChurchWork <notifications@church-work.com>
CHURCHWORK_REPLY_TO_EMAIL=
CHURCHWORK_ADMIN_ALERT_EMAIL=

# Cloudflare Turnstile public site key.
# The matching secret key is stored in Supabase Auth > Bot and Abuse Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
