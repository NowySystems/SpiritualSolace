# ChurchWork Supabase project
# Copy this file to .env.local for local development.
# Vercel should store these as project environment variables.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for internal-only admin/demo/diagnostic routes.
# Use a long random secret and store it only in local/Vercel environment configuration.
CHURCHWORK_INTERNAL_ACCESS_KEY=

# Server/admin only. Never expose this in browser code.
# Add only when server-side admin operations are implemented.
SUPABASE_SERVICE_ROLE_KEY=
